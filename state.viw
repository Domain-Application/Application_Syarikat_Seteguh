--START FILE

## DATE

DROP VIEW REP_STATE

CREATE VIEW REP_STATE
AS
SELECT     TICKET, LORRY, [DATE], ACCODE, AGENT, LOCATE, PT, DN, NET, RATE, TFEE, HFEE, PRICE, LESS, AMT AS AMT,'F' AS TYPE
FROM         dbo.RECEIVE 
WHERE [DATE] BETWEEN @two1 AND @two2 AND (PT BETWEEN '01' AND '03')
UNION ALL
SELECT     TICKET, LORRY, [DATE], ACCODE, AGENT, LOCATE, PT, DN, 0 AS NET, RATE, 0 AS TFEE, 0 AS HFEE, SUBSIDY AS PRICE, 0 AS LESS, SAMT AS AMT,'S' AS TYPE
FROM         dbo.RECEIVE
WHERE SUBSIDY IS NOT NULL AND [DATE] BETWEEN @two1 AND @two2 AND (PT BETWEEN '01' AND '03')
UNION ALL
SELECT     TICKET, LORRY, [DATE], ACCODE, AGENT, LOCATE, PT, DN, NET, RATE, TFEE, HFEE, PRICE, LESS, AMT*-1, 'F' AS TYPE
FROM         dbo.DESPATCH
WHERE [DATE] BETWEEN @two1 AND @two2 AND (PT BETWEEN '01' AND '03')
UNION ALL
SELECT     TICKET, LORRY, [DATE], ACCODE, AGENT, LOCATE, PT, DN, 0 AS NET, RATE, 0 AS TFEE, 0 AS HFEE, SUBSIDY AS PRICE, 0 AS LESS, SAMT*-1 AS AMT,'S' AS TYPE
FROM         dbo.DESPATCH
WHERE SUBSIDY IS NOT NULL AND [DATE] BETWEEN @two1 AND @two2 AND (PT BETWEEN '01' AND '03')


DROP VIEW REP_LEDGER


CREATE VIEW REP_LEDGER
AS
SELECT     A.ACCODE AS ACCODE, A.[DATE], A.REMARKS AS PARTICULAR, A.INVOICE, SUM(B.AMOUNT)  AS DEBIT,0 AS CREDIT, 0 AS TYPE
FROM         dbo.APINV_WB A LEFT OUTER JOIN
                      dbo.APOINV_WB B ON A.INVOICE = B.INVOICE
GROUP BY A.INVOICE, A.ACCODE, A.[DATE], A.REMARKS
UNION ALL
SELECT     ACCODE, [DATE], PARTICULAR, RECEIPT,0, TOTAL,  1
FROM          dbo.PAYMENT
UNION ALL
SELECT     A.ACCODE, A.[DATE], A.REMARKS, A.INVOICE, 0 AS DEBIT, SUM(B.AMOUNT) AS CREDIT, 0 AS TYPE
FROM         dbo.ARINV_WB A LEFT OUTER JOIN
                      dbo.AROINV_WB B ON A.INVOICE = B.INVOICE
GROUP BY A.INVOICE, A.ACCODE, A.[DATE], A.REMARKS
UNION ALL
SELECT     ACCODE, [DATE], PARTICULAR, RECEIPT, TOTAL as DEBIT, 0 as CREDIT, 1
FROM         dbo.RECEIPT
UNION ALL
SELECT     A.ACCODE, A.[DATE], A.PARTICULAR, A.REFNO, 0 AS DEBIT, SUM(B.AMOUNT) AS CREDIT, 0 AS TYPE
FROM         dbo.IREQ A LEFT OUTER JOIN
                      dbo.REQITEM B ON A.REFNO = B.REFNO
GROUP BY A.ACCODE, A.[DATE], A.PARTICULAR, A.REFNO
UNION ALL
SELECT     A.ACCODE, A.[DATE], A.PARTICULAR, A.REFNO, SUM(B.AMOUNT) AS DEBIT, 0 AS CREDIT, 1 AS TYPE
FROM         dbo.IENTRY A LEFT OUTER JOIN
                      dbo.INITEM B ON A.REFNO = B.REFNO
GROUP BY A.ACCODE, A.[DATE], A.PARTICULAR, A.REFNO
union all
SELECT     ACCODE, max([date]), 'WEIGHING FEE' AS PARTICULAR, NULL , 0 , SUM(WFEE) , 1 
FROM         dbo.RECEIVE
GROUP BY ACCODE, DATEDIFF([month], [DATE], GETDATE())


DROP VIEW REP_ACC

CREATE VIEW REP_ACC
AS
SELECT DISTINCT CODENO FROM(
SELECT CODENO
FROM ACCODE A LEFT OUTER JOIN REP_LEDGER R ON A.CODENO=R.ACCODE
WHERE R.[DATE]< @two1
GROUP BY CODENO
HAVING ISNULL(SUM(DEBIT)-SUM(CREDIT),0) <>0
UNION ALL
SELECT ACCODE
FROM REP_STATE
WHERE DATE BETWEEN @two1 and @two2
UNION ALL
SELECT ACCODE
FROM REP_LEDGER
WHERE DATE BETWEEN @two1 and @two2
)A

--END FILE