--START FILE

##

DROP VIEW [MASTER_1]

CREATE VIEW [MASTER_1]
AS
SELECT WB.DATE, WB.TICKET, WB.LORRY, WB.ACCODE AS ACCODE, ACCODE.ACCODE AS NAME, WB.PT, WB.DN, WB.GSNO, 0 AS TOQTY, WB.NET
FROM WB INNER JOIN ACCODE ON WB.ACCODE=ACCODE.CODENO
WHERE WB.DATE >= @two1 AND WB.DATE < @two2 

DROP VIEW [MASTER_2]

CREATE VIEW [MASTER_2]
AS
SELECT WB.DATE, WB.TICKET, WB.LORRY, WB.ACCODE AS ACCODE, ACCODE.ACCODE AS NAME, WB.PT , WB.DN, WB.GSNO, WB.NET, WB.NET
FROM WB INNER JOIN ACCODE ON WB.ACCODE=ACCODE.CODENO
WHERE WB.DATE = @two2 

--END FILE
